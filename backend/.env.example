# Copy to .env and fill in. NEVER commit the real .env.
APP_ENV=development            # set to "production" to disable /docs and demo seeding
DATABASE_URL=sqlite:///./wastewatch.db
# postgresql://user:password@host:5432/wastewatch   (production)

# REQUIRED: long random string used to sign JWTs.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins (dashboard URL). "*" is for local development only.
CORS_ORIGINS=*

MODEL_PATH=models/best.pt
UPLOAD_DIR=uploads
PORT=8000
LOG_LEVEL=INFO

# Dev-only demo passwords for `python -m app.seed` (random if left empty)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CITIZEN_PASSWORD=
