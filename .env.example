# Copy to .env (never commit .env). Used by docker-compose.yml; the non-Docker setup uses backend/.env.

# --- REQUIRED ---
POSTGRES_PASSWORD=
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- URLs ---
# Address the BROWSER/PHONE uses to reach the API (must be HTTPS for a real deployment).
PUBLIC_API_URL=http://localhost:8000
# Origin(s) of the dashboard, comma separated.
CORS_ORIGINS=http://localhost:8080

# --- Optional ---
POSTGRES_DB=wastewatch
POSTGRES_USER=wastewatch
# true = send report coordinates to OpenStreetMap Nominatim to fill village/town/district (privacy: 3rd party)
REVERSE_GEOCODING=false
GEOCODER_USER_AGENT=WasteWatch/2.0 (your-email@example.org)
# true = install the YOLO runtime in the API image (needed once you have a trained model)
INSTALL_AI=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
