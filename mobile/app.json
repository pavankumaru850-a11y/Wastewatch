{
  "expo": {
    "name": "WasteWatch",
    "slug": "wastewatch",
    "scheme": "wastewatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "WasteWatch uses your camera to photograph roadside waste for reporting."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WasteWatch uses your location to record exactly where waste was found."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WasteWatch lets you choose an existing photo of roadside waste to report."
        }
      ],
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "WasteWatch uses your camera to photograph roadside waste for reporting.",
        "NSLocationWhenInUseUsageDescription": "WasteWatch uses your location to record exactly where waste was found."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4D38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.wastewatch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b1266249-2c7c-4063-b036-6e9c89062709"
      }
    },
    "owner": "pavan6640"
  }
}
